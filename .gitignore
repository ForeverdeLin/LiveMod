# 编译输出
build/
build-*/
out/
bin/
obj/
*.o
*.obj
*.a
*.lib
*.so
*.so.*
*.dll
*.dylib
*.exe

# CMake
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
Makefile
compile_commands.json

# Qt
*.user
*.user.*
moc_*.cpp
moc_*.h
qrc_*.cpp
ui_*.h
*.qmlc
*.jsc

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# 日志和临时文件
*.log
*.tmp
core
core.*
*.core
.vs/

# 录制/输出媒体文件
*.mp4
*.h264
*.aac
*.flv
*.ts

# 第三方库目录（视情况保留）
3rdparty/
3rdParty/
